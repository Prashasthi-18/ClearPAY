# Production settings. Copy to /home/clearpay/clearpay/.env and fill in. Then:  chmod 600 .env
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODE=extract_only
GROQ_REASONING_EFFORT=low

# Long random string:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Password for the four demo users. Set it BEFORE the first start; the app refuses the built-in default.
DEMO_PASSWORD=

# Your public address (used in email links)
APP_BASE_URL=https://clearpay.example.com
# Behind Caddy/nginx with https
BEHIND_PROXY=1
SESSION_COOKIE_SECURE=1
# Hide the "Demo users..." hint on the sign-in page
SHOW_DEMO_HINT=0

# mock = emails only marked as sent. brevo = real emails over HTTPS (works on Render's free plan, which blocks SMTP).
# smtp = real emails over an SMTP server (needs outgoing ports 465/587 open).
EMAIL_MODE=brevo
BREVO_API_KEY=
# An address you verified as a sender in Brevo
MAIL_FROM=
MAIL_FROM_NAME=ClearPay
# While testing, send every email to this address instead of the real recipient (remove to go live)
EMAIL_REDIRECT_TO=
