# Copy this file to .env and fill in your values. Never commit .env.

# Groq API key (https://console.groq.com/keys). Leave empty to run in offline rule-based mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# How the AI is used:
#   auto         = the AI chooses which tool to call next (best demo; ~6,000 tokens per invoice)
#   extract_only = the AI only READS the invoice, code runs every check (~1,000 tokens per invoice).
#                  Use this on Groq's free plan (8,000 tokens/minute, 200,000/day).
#   offline      = never call the AI (rule-based reader; works for the sample invoices)
LLM_MODE=extract_only
# Thinking effort for gpt-oss models: low | medium | high | off (thinking tokens count against Groq's limits)
GROQ_REASONING_EFFORT=low

# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Password for the seeded demo users (prashasthi, ap_user2, mokshana, admin). Change it.
DEMO_PASSWORD=ChangeMe!2026

# Used in email links
APP_BASE_URL=http://127.0.0.1:5000
# Set to 1 when the app is served over HTTPS
SESSION_COOKIE_SECURE=0

# ---------- Email sending ----------
# mock  = emails are only marked as sent (default).
# smtp  = really send over an SMTP server (Gmail etc.) when a person presses "Send".
# brevo = really send through Brevo's email API over HTTPS. Use this on hosts that block SMTP ports (Render's free plan),
#         and it needs no Gmail login: set BREVO_API_KEY and MAIL_FROM (a sender address verified in Brevo).
EMAIL_MODE=mock
BREVO_API_KEY=
# Gmail: smtp.gmail.com, port 587, your Gmail address, and a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=ClearPay
# TEST MODE: send every email to this address instead of the real recipient. Remove to go live.
EMAIL_REDIRECT_TO=

# ---------- Reading invoices from an email inbox (optional) ----------
# ClearPay checks this mailbox every INBOX_POLL_SECONDS, takes invoice attachments (PDF/PNG/JPG/TXT) or an invoice
# typed in the email body, and runs them through the normal checks. Use a mailbox that ONLY receives invoices:
# every unread email in it is read and then marked as read. Gmail: turn on IMAP and use an App Password.
INBOX_IMAP_HOST=
INBOX_IMAP_PORT=993
INBOX_IMAP_USER=
INBOX_IMAP_PASSWORD=
INBOX_IMAP_FOLDER=INBOX
INBOX_POLL_SECONDS=60

# ---------- Running on a public server (see deploy/DEPLOY.md) ----------
# BEHIND_PROXY=1 when ClearPay sits behind Caddy/nginx with https. It also makes the app refuse to start
# without FLASK_SECRET_KEY, and refuse to create the demo users with the built-in demo password.
BEHIND_PROXY=0
# Show the "Demo users..." hint under the sign-in card (1 = show; keep 0 on a public site)
SHOW_DEMO_HINT=0

# ---------- Google sign-in (optional; see deploy/AUTH_SETUP.md) ----------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorised redirect URI" in Google exactly. Empty = worked out from the address you open ClearPay on,
# e.g. http://127.0.0.1:5000/auth/google/callback
GOOGLE_REDIRECT_URI=
# Only these email domains may use Google sign-in (comma-separated, e.g. yourcompany.com). Empty = any Google account.
GOOGLE_ALLOWED_DOMAINS=
# request = a new Google user can ask for an account (created inactive, an admin activates it); off = admins add everyone
GOOGLE_SIGNUP=request

# ---------- Two-factor authentication (authenticator app) ----------
# Roles that MUST set up two-factor (comma-separated: admin,manager,ap). Empty = optional for everyone.
MFA_REQUIRED_ROLES=
# Encrypts the authenticator secrets in the database. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it BEFORE anyone turns on two-factor, and never lose or change it (everyone would have to set up 2FA again).
MFA_ENCRYPTION_KEY=

# ---------- Database ----------
# Leave empty to use the SQLite file in data/. Set it to use PostgreSQL instead:
#   DATABASE_URL=postgresql://clearpay:your_password@localhost:5432/clearpay
# Then: python import_kaggle_pos.py   and   python load_po_data.py   (see deploy/POSTGRES.md)
DATABASE_URL=
